<Window
    x:Class="IracingSetupManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iRacing Setup Manager">
    <NavigationView
        x:Name="MainNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        RequestedTheme="Dark"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,12" Spacing="2">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="iRacing Setup Manager" />
                <TextBlock FontSize="12" Opacity="0.65" Text="Bibliothèque sécurisée" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Tableau de bord" Tag="dashboard">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Bibliothèque" Tag="library">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Synchronisation" Tag="synchronization">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="À vérifier" Tag="review">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Historique et erreurs" Tag="history">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Mises à jour" Tag="updates">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>

