<Window
    x:Class="IracingSetupManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iRacing Setup Manager">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                FontSize="32"
                FontWeight="SemiBold"
                Text="iRacing Setup Manager" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.75"
                Text="Votre bibliothèque de setups, centralisée et sécurisée." />
        </StackPanel>
    </Grid>
</Window>

