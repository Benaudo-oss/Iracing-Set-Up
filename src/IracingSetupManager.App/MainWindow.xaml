<Window
    x:Class="IracingSetupManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iRacing Setup Manager">
    <NavigationView
        x:Name="MainNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        Background="#FF111317"
        Foreground="#FFF5F5F5"
        PaneDisplayMode="Left"
        RequestedTheme="Dark"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,12" Orientation="Horizontal" Spacing="10">
                <Image
                    Width="42"
                    Height="42"
                    Source="ms-appx:///Assets/AppLogo.png"
                    Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="iRacing Setup Manager" />
                    <TextBlock FontSize="12" Opacity="0.72" Text="Bibliothèque sécurisée" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Tableau de bord" Tag="dashboard">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Bibliothèque" Tag="library">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Synchronisation" Tag="synchronization">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Copie vers iRacing" Tag="iracing-copy">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Copie vers iRacing Team" Tag="iracing-team-copy">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE902;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="À vérifier" Tag="review">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
                <NavigationViewItem Content="Historique" Tag="history">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Mises à jour" Tag="updates">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="À propos / Mentions légales" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
