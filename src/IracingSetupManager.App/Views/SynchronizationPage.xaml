<Page
    x:Class="IracingSetupManager.App.Views.SynchronizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Synchronisation" /><TextBlock Opacity="0.65" Text="Choisissez les sources et catégories à importer" /></StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Import autorisé uniquement" Message="L’application surveille Téléchargements et les dossiers des applications officielles. Le dossier iRacing n’est jamais surveillé." />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Fournisseurs" />
                        <CheckBox Content="HYMO" IsChecked="True" />
                        <CheckBox Content="GO Setups" IsChecked="True" />
                        <CheckBox Content="Grid &amp; Go" IsChecked="True" />
                        <CheckBox Content="VRS" IsChecked="True" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" Background="#FF20242B" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Catégories" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <CheckBox Content="GT3" IsChecked="True" /><CheckBox Grid.Column="1" Content="GT4" IsChecked="True" /><CheckBox Grid.Column="2" Content="GTE" IsChecked="True" />
                            <CheckBox Grid.Row="1" Content="LMP2" IsChecked="True" /><CheckBox Grid.Row="1" Grid.Column="1" Content="GTP" IsChecked="True" /><CheckBox Grid.Row="1" Grid.Column="2" Content="PCUP" IsChecked="True" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="12">
                    <Grid><TextBlock FontSize="20" FontWeight="SemiBold" Text="Progression" /><TextBlock HorizontalAlignment="Right" Opacity="0.65" Text="En attente" /></Grid>
                    <ProgressBar Value="0" />
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Fournisseur : —" /><TextBlock Grid.Column="1" Text="Voiture : —" /><TextBlock Grid.Column="2" Text="Circuit : —" /><TextBlock Grid.Column="3" Text="Fichiers : 0 / 0" /></Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Analyser maintenant" Click="OnScanNow" />
                <Button Content="Démarrer la surveillance" Style="{StaticResource AccentButtonStyle}" Click="OnStartMonitoring" />
            </StackPanel>
            <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True" Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
