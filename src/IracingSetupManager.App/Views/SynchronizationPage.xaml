<Page
    x:Class="IracingSetupManager.App.Views.SynchronizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Synchronisation" /><TextBlock Opacity="0.65" Text="Importe les fichiers .sto et les archives qui contiennent des setups .sto" /></StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Fichiers acceptés" Message="Seuls les fichiers .sto, ainsi que les archives .zip ou .rar contenant au moins un fichier .sto, sont importés. Le dossier iRacing n’est jamais surveillé." />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Fournisseurs" />
                        <CheckBox x:Name="HymoProvider" Content="HYMO" />
                        <CheckBox x:Name="GoProvider" Content="GO Setups" />
                        <CheckBox x:Name="GngProvider" Content="Grid &amp; Go" />
                        <CheckBox x:Name="VrsProvider" Content="VRS" />
                        <CheckBox x:Name="SrsProvider" Content="SRS" />
                        <CheckBox x:Name="P1DoksProvider" Content="P1Doks" />
                        <CheckBox x:Name="CdaProvider" Content="Coach Dave Academy (CDA)" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" Background="#FF20242B" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Catégories" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <CheckBox x:Name="Gt3Category" Content="GT3" /><CheckBox x:Name="Gt4Category" Grid.Column="1" Content="GT4" /><CheckBox x:Name="GteCategory" Grid.Column="2" Content="GTE" />
                            <CheckBox x:Name="Lmp2Category" Grid.Row="1" Content="LMP2" /><CheckBox x:Name="Lmp3Category" Grid.Row="1" Grid.Column="1" Content="LMP3" /><CheckBox x:Name="GtpCategory" Grid.Row="1" Grid.Column="2" Content="GTP" />
                            <CheckBox x:Name="PcupCategory" Grid.Row="2" Content="PCUP" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Padding="16" Background="#FF20242B" CornerRadius="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Mode de synchronisation" /><TextBlock x:Name="SynchronizationModeText" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="1" Content="Modifier dans Paramètres" Click="OnOpenSettings" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="ClearResultsButton" Content="Effacer les résultats" Click="OnClearResults" />
                <Button x:Name="StopScanButton" Content="Interrompre" IsEnabled="False" Click="OnStopScan" />
                <Button x:Name="ScanNowButton" Content="Synchroniser maintenant" Style="{StaticResource AccentButtonStyle}" Click="OnScanNow" />
            </StackPanel>
            <Border Padding="18" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressText" FontWeight="SemiBold" Text="Aucune synchronisation en cours" />
                        <TextBlock x:Name="ProgressCountersText" Grid.Column="1" Opacity="0.7" />
                    </Grid>
                    <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="1" Value="0" />
                    <ListView x:Name="SynchronizationResultsList" SelectionMode="None" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyResultsText" HorizontalAlignment="Center" Opacity="0.6" Text="Aucun fichier traité pour le moment." />
                </StackPanel>
            </Border>
            <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True" Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
