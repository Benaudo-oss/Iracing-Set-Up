<Page
    x:Class="IracingSetupManager.App.Views.SynchronizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Page.Resources>
        <Style x:Key="SelectionTileStyle" TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,0,12,0" />
            <Setter Property="Background" Value="#FF252A32" />
            <Setter Property="BorderBrush" Value="#FF343A45" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8ED8FA" />
        </Style>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Synchronisation" /><TextBlock Opacity="0.65" Text="Importe les fichiers .sto et les archives qui contiennent des setups .sto" /></StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Fichiers acceptés" Message="Seuls les fichiers .sto, ainsi que les archives .zip ou .rar contenant au moins un fichier .sto, sont importés. Le dossier iRacing n’est jamais surveillé." />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="20" Background="#FF20242B" BorderBrush="#FF303640" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Fournisseurs" />
                                <TextBlock Opacity="0.62" Text="Choisissez les sources à surveiller" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                <Button Content="Tout sélectionner" Style="{StaticResource CardActionButtonStyle}" Click="OnSelectAllProviders" />
                                <Button Content="Tout désélectionner" Style="{StaticResource CardActionButtonStyle}" Click="OnClearProviders" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <CheckBox x:Name="HymoProvider" Content="HYMO" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="GoProvider" Grid.Column="1" Content="GO Setups" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="GngProvider" Grid.Row="1" Content="Grid &amp; Go" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="VrsProvider" Grid.Row="1" Grid.Column="1" Content="VRS" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="SrsProvider" Grid.Row="2" Content="SRS" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="P1DoksProvider" Grid.Row="2" Grid.Column="1" Content="P1Doks" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="CdaProvider" Grid.Row="3" Grid.ColumnSpan="2" Content="Coach Dave Academy (CDA)" Style="{StaticResource SelectionTileStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" Background="#FF20242B" BorderBrush="#FF303640" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Catégories" />
                                <TextBlock Opacity="0.62" Text="Choisissez les classes à importer" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                <Button Content="Tout sélectionner" Style="{StaticResource CardActionButtonStyle}" Click="OnSelectAllCategories" />
                                <Button Content="Tout désélectionner" Style="{StaticResource CardActionButtonStyle}" Click="OnClearCategories" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <CheckBox x:Name="Gt3Category" Content="GT3" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="Gt4Category" Grid.Column="1" Content="GT4" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="GteCategory" Grid.Column="2" Content="GTE" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="Lmp2Category" Grid.Row="1" Content="LMP2" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="Lmp3Category" Grid.Row="1" Grid.Column="1" Content="LMP3" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="GtpCategory" Grid.Row="1" Grid.Column="2" Content="GTP" Style="{StaticResource SelectionTileStyle}" />
                            <CheckBox x:Name="PcupCategory" Grid.Row="2" Grid.ColumnSpan="3" Content="PCUP" Style="{StaticResource SelectionTileStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Padding="16" Background="#FF20242B" CornerRadius="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Mode de synchronisation" /><TextBlock x:Name="SynchronizationModeText" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="1" Content="Modifier dans Paramètres" Click="OnOpenSettings" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="ClearResultsButton" Content="Effacer les résultats" Click="OnClearResults" />
                <Button x:Name="StopScanButton" Content="Interrompre" IsEnabled="False" Click="OnStopScan" />
                <Button x:Name="ScanNowButton" Content="Synchroniser maintenant" Style="{StaticResource AccentButtonStyle}" Click="OnScanNow" />
            </StackPanel>
            <Border Padding="18" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressText" FontWeight="SemiBold" Text="Aucune synchronisation en cours" />
                        <TextBlock x:Name="ProgressCountersText" Grid.Column="1" Opacity="0.7" />
                    </Grid>
                    <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="1" Value="0" />
                    <ListView x:Name="SynchronizationResultsList" SelectionMode="None" MaxHeight="360">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyResultsText" HorizontalAlignment="Center" Opacity="0.6" Text="Aucun fichier traité pour le moment." />
                </StackPanel>
            </Border>
            <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True" Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
