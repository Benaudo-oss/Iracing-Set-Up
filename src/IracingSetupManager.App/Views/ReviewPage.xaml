<Page
    x:Class="IracingSetupManager.App.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="32" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="À vérifier" /><TextBlock Opacity="0.65" Text="Contrôlez chaque setup avant validation ou envoi" /></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Content="Tout sélectionner" />
            <Button Content="Valider la sélection" Style="{StaticResource AccentButtonStyle}" Click="OnValidateSelection" />
            <Button Content="Marquer privé" />
            <Button Content="Refuser" />
        </StackPanel>
        <Border Grid.Row="2" Padding="20" Background="#FF20242B" CornerRadius="10">
            <Grid>
                <ListView x:Name="ReviewList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="3"><TextBlock FontWeight="SemiBold" Text="{Binding OriginalFileName}" /><TextBlock Opacity="0.65"><Run Text="{Binding Provider}" /><Run Text=" · " /><Run Text="{Binding Car}" /><Run Text=" · " /><Run Text="{Binding Track}" /></TextBlock></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><FontIcon FontSize="36" Glyph="&#xE9D5;" Opacity="0.45" /><TextBlock Opacity="0.65" Text="Aucun nouveau setup à vérifier" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
