<Page
    x:Class="IracingSetupManager.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Mises à jour" /><TextBlock Opacity="0.65" Text="Versions publiées et intégrité des installateurs" /></StackPanel>
            <Border Padding="24" Background="#FF20242B" CornerRadius="10">
                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Version installée" /><TextBlock FontSize="32" Text="0.1.0-dev" /><TextBlock Opacity="0.65" Text="Canal stable · vérification SHA-256 activée" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="Rechercher les mises à jour" Style="{StaticResource AccentButtonStyle}" Click="OnCheckUpdates" /></Grid>
            </Border>
            <InfoBar x:Name="UpdateInfo" IsOpen="False" IsClosable="True" Severity="Informational" Title="Recherche terminée" Message="Aucune mise à jour disponible." />
            <Border Padding="20" Background="#FF20242B" CornerRadius="10"><StackPanel Spacing="10"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Notes de version" /><TextBlock Opacity="0.65" TextWrapping="Wrap" Text="Les nouveautés, corrections et modifications importantes apparaîtront ici lorsqu’une version sera publiée sur GitHub Releases." /></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</Page>

