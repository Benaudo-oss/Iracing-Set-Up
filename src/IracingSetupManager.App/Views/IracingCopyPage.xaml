<Page
    x:Class="IracingSetupManager.App.Views.IracingCopyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitle" FontSize="32" FontWeight="SemiBold" Text="Copie vers iRacing" />
            <TextBlock x:Name="PageSubtitle" Opacity="0.65" Text="Prévisualisez chaque destination avant de copier les setups validés." />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="FolderPathBox" Header="Dossier officiel des setups iRacing" IsReadOnly="True" PlaceholderText="Documents\iRacing\setups" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Détecter" Click="OnDetectFolder" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Sélectionner" Click="OnPickFolder" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="Tout sélectionner" Click="OnSelectAll" />
            <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid><TextBox x:Name="SearchBox" Height="40" Padding="34,0,8,0" PlaceholderText="Rechercher…" TextChanged="OnFilterChanged" /><FontIcon Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" Glyph="&#xE721;" /></Grid>
            <Grid Grid.Column="1"><ComboBox x:Name="ProviderFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="Fournisseur" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Glyph="&#xE77B;" /></Grid>
            <Grid Grid.Column="2"><ComboBox x:Name="CategoryFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="Catégorie" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" Glyph="&#xE80F;" /></Grid>
            <Grid Grid.Column="3"><ComboBox x:Name="SeasonFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="Saison" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Glyph="&#xE787;" /></Grid>
            <Grid Grid.Column="4"><ComboBox x:Name="CarFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="Voiture" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" Glyph="&#xE806;" /></Grid>
            <Grid Grid.Column="5"><ComboBox x:Name="TrackFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="Circuit" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" Glyph="&#xE707;" /></Grid>
            <Grid Grid.Column="6"><ComboBox x:Name="CopyStatusFilter" Height="40" Padding="30,0,6,0" HorizontalAlignment="Stretch" PlaceholderText="État de copie" SelectionChanged="OnFilterChanged" /><FontIcon Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14" Glyph="&#xE73E;" /></Grid>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ActiveFiltersPanel" Orientation="Horizontal" Spacing="8" /></ScrollViewer><TextBlock x:Name="ResultCountText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" Text="0 résultat" /><Button Grid.Column="2" Padding="10,6" Click="OnClearFilters" ToolTipService.ToolTip="Effacer tous les filtres"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontSize="13" Glyph="&#xE711;" /><TextBlock Text="Effacer" /></StackPanel></Button></Grid>
        <ListView x:Name="SetupList" Grid.Row="5" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding OriginalFileName}" /><TextBlock Opacity="0.65" Text="{Binding Car}" /></StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Provider}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CopyDescription}" TextWrapping="Wrap" />
                        <ComboBox Grid.Column="3" Width="170" Header="En cas de conflit" Visibility="{Binding ConflictVisibility}" SelectedIndex="{Binding ConflictChoiceIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="À choisir" /><ComboBoxItem Content="Ignorer" /><ComboBoxItem Content="Conserver les deux" />
                        </ComboBox>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="6">
            <InfoBar x:Name="ActionInfo" HorizontalAlignment="Left" IsOpen="False" IsClosable="True" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button x:Name="ExitPreviewButton" Content="Quitter l’aperçu" Visibility="Collapsed" Click="OnExitPreview" />
                <Button x:Name="PreviewButton" Content="Afficher les fichiers à copier" Style="{StaticResource AccentButtonStyle}" Click="OnCreatePreview" />
                <Button x:Name="CopyButton" Content="Copier les fichiers affichés" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="OnCopy" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
