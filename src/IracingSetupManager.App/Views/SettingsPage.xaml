<Page
    x:Class="IracingSetupManager.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">
            <StackPanel Spacing="4"><TextBlock FontSize="32" FontWeight="SemiBold" Text="Paramètres" /><TextBlock Opacity="0.65" Text="Archive, dossiers surveillés, sécurité et préférences" /></StackPanel>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Bibliothèque principale" />
                    <TextBlock Opacity="0.65" Text="Les fichiers originaux restent dans cette archive et ne sont jamais renommés." />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ArchivePathBox" IsReadOnly="True" PlaceholderText="Choisir le dossier d’archive…" /><Button Grid.Column="1" Content="Parcourir" Click="OnChooseArchive" /></Grid>
                    <Button HorizontalAlignment="Left" Content="Réorganiser l’archive maintenant" Click="OnReorganizeArchive" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Copie vers iRacing Team" />
                    <TextBlock Opacity="0.65" Text="Saisissez exactement le nom utilisé par la Team sur Garage61. Le dossier sera créé sous la forme Garage 61 - Nom de la Team." TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="IracingTeamNameBox" Header="Nom exact de la Team sur Garage61" PlaceholderText="Exemple : BENAUDO Racing" KeyDown="OnTeamNameKeyDown" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Enregistrer la Team" Style="{StaticResource AccentButtonStyle}" Click="OnSaveTeamName" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dossiers surveillés" />
                    <ToggleSwitch x:Name="AutomaticMonitoringToggle" Header="Surveillance automatique" OnContent="Activée" OffContent="Désactivée" Toggled="OnAutomaticMonitoringToggled" />
                    <TextBlock Opacity="0.65" Text="Lorsqu’elle est désactivée, seuls les imports lancés manuellement depuis Synchronisation sont effectués." TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Protection des setups privés" Message="Le dossier iRacing général reste interdit. Pour HYMO, seuls les dossiers Track Titan des voitures appartenant aux catégories sélectionnées sont surveillés." />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Téléchargements" /><TextBox x:Name="DownloadsPathBox" Grid.Column="1" IsReadOnly="True" /><ToggleSwitch x:Name="DownloadsToggle" Grid.Column="2" IsOn="True" OnContent="Actif" OffContent="Inactif" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="HYMO" /><TextBox x:Name="HymoPathBox" Grid.Column="1" IsReadOnly="True" /><TextBlock x:Name="HymoModeText" Grid.Column="2" VerticalAlignment="Center" Foreground="#FF66BB6A" Text="Automatique selon les catégories sélectionnées" TextWrapping="Wrap" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="GO Setups" /><TextBox x:Name="GoPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de GO Fast" /><ToggleSwitch x:Name="GoToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="GO Setups" Click="OnChooseProviderFolder" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Grid &amp; Go" /><TextBox x:Name="GngPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de Grid &amp; Go" /><ToggleSwitch x:Name="GngToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="Grid &amp; Go" Click="OnChooseProviderFolder" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="VRS" /><TextBox x:Name="VrsPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de l’application VRS" /><ToggleSwitch x:Name="VrsToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="VRS" Click="OnChooseProviderFolder" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="SRS" /><TextBox x:Name="SrsPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de l’application SRS" /><ToggleSwitch x:Name="SrsToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="SRS" Click="OnChooseProviderFolder" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="P1Doks" /><TextBox x:Name="P1DoksPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de P1Doks" /><ToggleSwitch x:Name="P1DoksToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="P1Doks" Click="OnChooseProviderFolder" /></Grid>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="CDA" /><TextBox x:Name="CdaPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Dossier de Coach Dave Academy" /><ToggleSwitch x:Name="CdaToggle" Grid.Column="2" OnContent="Actif" OffContent="Inactif" /><Button Grid.Column="3" Content="Choisir" Tag="Coach Dave Academy (CDA)" Click="OnChooseProviderFolder" /></Grid>
                </StackPanel>
            </Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Arborescence de copie vers iRacing" />
                    <TextBlock Opacity="0.65" Text="Modifiez l’ordre des dossiers variables. Le dossier de la voiture et Garage 61 restent obligatoires pour iRacing." TextWrapping="Wrap" />
                    <ListView x:Name="PathLayoutList" SelectionMode="Single" MaxWidth="520" HorizontalAlignment="Left">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="480" Padding="6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                                    <Button Grid.Column="1" Content="Monter" Tag="{Binding Key}" Click="OnMovePathUp" />
                                    <Button Grid.Column="2" Content="Descendre" Tag="{Binding Key}" Click="OnMovePathDown" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="Aperçu" FontWeight="SemiBold" />
                    <TextBlock x:Name="PathLayoutPreview" Opacity="0.75" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Content="Rétablir l’ordre par défaut" Click="OnResetPathLayout" />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dictionnaire de reconnaissance" />
                    <TextBlock Opacity="0.65" Text="Les abréviations mémorisées lors d’une correction sont prioritaires pour les prochains imports. Vous pouvez les supprimer ici." TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Content="Ajouter une abréviation" Style="{StaticResource AccentButtonStyle}" Click="OnAddRecognitionAlias" />
                    <ListView x:Name="RecognitionAliasesList" SelectionMode="None" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding KindLabel}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Alias}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CanonicalValue}" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="3" Tag="{Binding Id}" Content="Modifier" Click="OnEditRecognitionAlias" />
                                    <Button Grid.Column="4" Tag="{Binding Id}" Content="Supprimer" Click="OnDeleteRecognitionAlias" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoRecognitionAliasesText" Opacity="0.65" Text="Aucune abréviation personnelle enregistrée." />
                </StackPanel>
            </Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10"><StackPanel Spacing="8"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Confidentialité" /><TextBlock Opacity="0.75" Text="Les setups inconnus restent dans À vérifier. Toute validation groupée demande une confirmation explicite." TextWrapping="Wrap" /></StackPanel></Border>
            <Border Padding="20" Background="#FF20242B" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sauvegarde locale" />
                    <TextBlock Opacity="0.65" Text="Crée une copie cohérente de la base SQLite, sans mot de passe ni cookie." />
                    <Button HorizontalAlignment="Left" Content="Sauvegarder la base de données" Click="OnBackupDatabase" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="SettingsInfo" IsOpen="False" IsClosable="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Enregistrer les paramètres" Style="{StaticResource AccentButtonStyle}" Click="OnSave" /></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
